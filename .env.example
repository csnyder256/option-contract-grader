# Copy this file to .env and edit as needed. Every value below is optional:
# the app runs with zero credentials on the free CBOE delayed feed.
# Never commit a real .env - it is gitignored for a reason.

# Data backend: "cboe" (free, no account, ~15-min delayed) or "tradier".
DATA_PROVIDER=cboe

# --- Tradier (only needed when DATA_PROVIDER=tradier) ------------------------
# Get a token at https://dash.tradier.com (Settings -> API Access).
# A FREE Tradier *Brokerage* account is required for REAL-TIME options data.
TRADIER_TOKEN=your-tradier-token-here

# "production" (real-time, needs a brokerage account) or "sandbox" (~15-min delayed).
TRADIER_ENV=sandbox

# --- Black-Scholes engine inputs ---------------------------------------------
# Annualized risk-free rate as a decimal (0.04 = 4%). Track the 3-month T-bill.
RISK_FREE_RATE=0.04
# Fallback annual dividend yield when the provider does not supply one.
DEFAULT_DIVIDEND_YIELD=0.0
# Trading days of history used for the realized-volatility (HV) estimate.
HV_WINDOW=30

# --- Single-ticker scan limits ------------------------------------------------
# Max number of nearest expirations to scan when no date range is given.
MAX_EXPIRATIONS=6
# Max scored contracts returned by a single scan.
MAX_RESULTS=100
# Keep only the k strikes nearest the money per name (0 = all strikes).
ATM_STRIKE_WINDOW=0
# Default expiration window in days-to-expiry when the caller gives no range.
DEFAULT_MIN_DTE=14
DEFAULT_MAX_DTE=60

# --- Liquidity gate -----------------------------------------------------------
# Contracts wider than this bid/ask spread (fraction of mid) are capped at F.
MAX_SPREAD_PCT=0.15
# Contracts below this open interest are capped at F.
MIN_OPEN_INTEREST=50

# --- Market sweep tuning ------------------------------------------------------
# Cap how many universe names the sweep prices (0 = the whole universe file).
MAX_UNIVERSE=0
# Cap how many in-band names the sweep fetches chains for (0 = no cap).
# Code default is 2000; 1500 is a lighter, faster setting.
MAX_CHAIN_SCANS=1500
# In-band set at/below this size uses the real-time provider; above it, CBOE bulk.
REALTIME_CHAIN_THRESHOLD=300
# Best contracts kept per name before the global merge.
PER_SYMBOL_CAP=25
# Max contracts per underlying on the final Top-N board (stops one name flooding it).
PER_NAME_BOARD_CAP=2
# Worker concurrency for the sweep (4 is gentle on the free Yahoo/CBOE feeds).
SWEEP_MAX_WORKERS=4
# How fresh (hours) a cached price/HV must be to be reused (TTL, not calendar day).
CACHE_TTL_HOURS=12
# Symbols per batched quote request on the Tradier price pre-pass.
QUOTE_BATCH_SIZE=100

# --- Free-feed retry / backoff -------------------------------------------------
# Attempts before a fetch raises FeedError.
FEED_RETRIES=4
# Exponential backoff base and ceiling, in seconds.
FEED_BACKOFF_BASE=1.0
FEED_BACKOFF_CAP=30.0

# --- Storage -------------------------------------------------------------------
# Relative path to the SQLite store for IV-rank snapshots and the price cache.
DB_PATH=data/options.db
